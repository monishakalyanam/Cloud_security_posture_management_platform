# Copy this file to ".env" (same folder) and fill in the values. Never commit ".env".

# Port the API listens on
PORT=5000

# Local MongoDB. 127.0.0.1 is used instead of "localhost" because on Windows "localhost" can resolve to IPv6.
MONGODB_URI=mongodb://127.0.0.1:27017/cspm

# Long random text used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=1d

# Frontend address(es) allowed to call the API (comma-separated). Used for CORS.
CLIENT_ORIGIN=http://localhost:5173
